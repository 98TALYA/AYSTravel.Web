<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - AYS GUIDE 2030</title>

    <link rel="icon" type="image/png" href="~/image/logo.png">

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">

    <!-- CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)
</head>

<body>

    <!-- ================= NAVBAR ================= -->
    <nav class="navbar navbar-expand-lg ays-navbar fixed-top">
        <div class="container">

            <a class="navbar-brand d-flex align-items-center gap-2"
               asp-controller="Home" asp-action="Index">
                <img src="~/image/logo.png" alt="AYS Guide Logo" class="brand-logo">
                <span class="brand-name">AYS GUIDE</span>
                <span class="brand-year">2030</span>
            </a>

            <button class="navbar-toggler text-white"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#aysNav">
                <i class="bi bi-list"></i>
            </button>

            <div class="collapse navbar-collapse justify-content-center" id="aysNav">
                <ul class="navbar-nav gap-4">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Accueil</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Ville" asp-action="Index">Villes</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Match" asp-action="Index">Matchs</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Monument" asp-action="Index">Monuments</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Restauration" asp-action="Index">Restaurations</a></li>
                </ul>
            </div>

            
                   

                  @*  <!-- PROFIL -->
                    <li class="nav-item mx-2">
                        <a class="btn btn-outline-light px-3"
                           asp-area="Identity"
                           asp-page="/Account/Manage/Index"
                           title="Profil">
                            👤 @User.Identity?.Name
                        </a>
                    </li>

                    <!-- LOGOUT -->
                    <li class="nav-item mx-2">
                        <form asp-area="Identity"
                              asp-page="/Account/Logout"
                              asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                              method="post">

                            <button type="submit"
                                    class="btn btn-outline-warning px-3">
                                🚪 Déconnexion
                            </button>
                        </form>
                    </li> *@

            <!-- AUTH -->
            <ul class="navbar-nav ms-auto align-items-center">

                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    

                    <!-- PROFIL -->
                    <li class="nav-item me-2">
                        <a class="btn btn-outline-light rounded-pill px-3"
                           asp-area="Identity"
                           asp-page="/Account/Manage/Index">
                            <i class="bi bi-person me-1"></i> Profil
                        </a>
                    </li>

                    <!-- ADMIN -->
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item me-2">
                            <a class="btn btn-warning rounded-pill px-3 fw-semibold"
                               asp-controller="Admin"
                               asp-action="Index">
                                ⚙ Admin
                            </a>
                        </li>
                    }

                    <!-- USER -->
                    @if (User.IsInRole("User"))
                    {
                        <li class="nav-item me-2">
                            <a class="btn btn-outline-info rounded-pill px-3"
                               asp-controller="Reservation"
                               asp-action="MyReservations">
                                <i class="bi bi-calendar-check me-1"></i> Réservations
                            </a>
                        </li>
                    }

                    <!-- LOGOUT -->
                    <li class="nav-item">
                        <form asp-area="Identity" asp-page="/Account/Logout" method="post">
                            <button class="btn btn-outline-danger rounded-pill px-3">
                                <i class="bi bi-box-arrow-right me-1"></i> Déconnexion
                            </button>
                        </form>
                    </li>
                }
                else
                {
                    <!-- LOGIN -->
                    <li class="nav-item me-2">
                        <a class="btn btn-outline-light rounded-pill px-3"
                           asp-area="Identity"
                           asp-page="/Account/Login">
                            Connexion
                        </a>
                    </li>

                    <!-- REGISTER -->
                    <li class="nav-item">
                        <a class="btn btn-warning rounded-pill px-3 fw-semibold"
                           asp-area="Identity"
                           asp-page="/Account/Register">
                            Inscription
                        </a>
                    </li>
                }

            </ul>
        </div>
    </nav>

    <!-- ================= PAGE CONTENT ================= -->
    <main class="page-wrapper">
        @RenderBody()
    </main>

    <!-- ================= FOOTER ================= -->
    
    <footer class="ays-footer">
        <div class="container">

            <div class="row gy-4 align-items-start">

                <!-- À propos -->
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <img src="~/image/logo.png" class="brand-logo">
                        <h5 class="mb-0">AYS GUIDE</h5>
                    </div>
                    <p>
                        Application premium pour découvrir le Maroc pendant
                        la Coupe du Monde 2030. Explorez les villes, stades,
                        monuments et restaurants en une expérience immersive.
                    </p>
                </div>

                <!-- Navigation -->
                <div class="col-lg-2 col-md-6">
                    <h6>Navigation</h6>
                    <ul class="list-unstyled footer-links">
                        <li><a asp-controller="Home" asp-action="Index">Accueil</a></li>
                        <li><a asp-controller="Ville" asp-action="Index">Villes</a></li>
                        <li><a asp-controller="Match" asp-action="Index">Matchs</a></li>
                        <li><a asp-controller="Monument" asp-action="Index">Monuments</a></li>
                        <li><a asp-controller="Restauration" asp-action="Index">Restaurations</a></li>
                    </ul>
                </div>

                <!-- Contact -->
                <div class="col-lg-3 col-md-6">
                    <h6>Contact</h6>
                    <ul class="list-unstyled footer-contact">
                        <li><i class="bi bi-geo-alt me-2"></i>Meknes, Maroc</li>
                        <li><i class="bi bi-envelope me-2"></i>ayscoding.com</li>
                        <li><i class="bi bi-telephone me-2"></i>+212 6 00 00 00 00</li>
                    </ul>
                </div>

                <!-- Social -->
                <div class="col-lg-3 col-md-6 text-lg-end">
                    <h6>Suivez-nous</h6>
                    <div class="footer-social">
                        <a href="#"><i class="bi bi-facebook"></i></a>
                        <a href="#"><i class="bi bi-instagram"></i></a>
                        <a href="#"><i class="bi bi-youtube"></i></a>
                    </div>
                </div>

            </div>

            <hr>

            <div class="text-center footer-copy">
                © @DateTime.Now.Year AYS GUIDE — Tous droits réservés.
            </div>

        </div>
    </footer>

    <!-- JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
    @RenderSection("Script", required: false)

</body>
</html>