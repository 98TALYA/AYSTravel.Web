<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - AYS GUIDE 2030</title>

    <link rel="icon" type="image/png" href="~/image/logo.png">

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">

    <!-- CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)
    <!-- ===== CHATBOT WIDGET ===== -->
    <div id="chatbot-widget">

        <button id="chatbot-toggle" onclick="toggleChat()">
            <span>⚽</span>
        </button>

        <div id="chatbot-window" style="display:none;">
            <div id="chatbot-header">
                <div class="chatbot-avatar">🤖</div>
                <div>
                    <strong>AYS Assistant</strong>
                    <small>Coupe du Monde 2030 · Maroc</small>
                </div>
                <button onclick="toggleChat()" class="chatbot-close">✕</button>
            </div>

            <div id="chatbot-messages">
                <div class="chat-msg bot">
                    👋 Bonjour ! Je suis votre assistant pour la Coupe du Monde 2030 au Maroc.
                    Comment puis-je vous aider ?
                </div>
            </div>

            <div id="chatbot-suggestions">
                <button onclick="askSuggestion('Quelles sont les villes hôtes ?')">🏙️ Villes hôtes</button>
                <button onclick="askSuggestion('Comment se déplacer au Maroc ?')">🚌 Transport</button>
                <button onclick="askSuggestion('Meilleurs restaurants à Marrakech ?')">🍽️ Restaurants</button>
                <button onclick="askSuggestion('Infos sur les matchs CM2030')">⚽ Matchs</button>
            </div>

            <div id="chatbot-input-row">
                <input type="text"
                       id="chatbot-input"
                       placeholder="Posez votre question..."
                       onkeypress="handleKey(event)" />
                <button onclick="sendMessage()">➤</button>
            </div>
        </div>
    </div>

    <style>
        #chatbot-widget {
            position: fixed;
            bottom: 30px;
            right: 30px;
            z-index: 9999;
            font-family: 'DM Sans', sans-serif;
        }

        #chatbot-toggle {
            width: 62px;
            height: 62px;
            border-radius: 50%;
            background: linear-gradient(135deg, #f5a623, #e8572a);
            border: none;
            font-size: 26px;
            cursor: pointer;
            box-shadow: 0 6px 24px rgba(245,166,35,0.5);
            transition: transform 0.3s ease;
            animation: bounce 2s infinite;
        }

        @@keyframes bounce {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-6px);
            }
        }

        #chatbot-toggle:hover {
            animation: none;
            transform: scale(1.1);
        }

        #chatbot-window {
            position: absolute;
            bottom: 80px;
            right: 0;
            width: 370px;
            background: #161b22;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 24px 60px rgba(0,0,0,0.6);
            border: 1px solid rgba(255,255,255,0.08);
        }

        #chatbot-header {
            background: linear-gradient(135deg, #0f2027, #203a43);
            padding: 16px 20px;
            display: flex;
            align-items: center;
            gap: 12px;
            color: white;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

        .chatbot-avatar {
            width: 42px;
            height: 42px;
            background: linear-gradient(135deg, #f5a623, #e8572a);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        #chatbot-header strong {
            display: block;
            font-size: 0.95rem;
            color: #fff;
        }

        #chatbot-header small {
            font-size: 0.7rem;
            color: #a8d8ea;
        }

        .chatbot-close {
            margin-left: auto;
            background: rgba(255,255,255,0.1);
            border: none;
            color: white;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            cursor: pointer;
            font-size: 12px;
            transition: background 0.2s;
        }

            .chatbot-close:hover {
                background: rgba(255,255,255,0.2);
            }

        #chatbot-messages {
            height: 300px;
            overflow-y: auto;
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

            #chatbot-messages::-webkit-scrollbar {
                width: 4px;
            }

            #chatbot-messages::-webkit-scrollbar-thumb {
                background: rgba(255,255,255,0.1);
                border-radius: 4px;
            }

        .chat-msg {
            max-width: 85%;
            padding: 10px 14px;
            border-radius: 16px;
            font-size: 0.84rem;
            line-height: 1.5;
        }

            .chat-msg.bot {
                background: rgba(255,255,255,0.07);
                color: #e2e8f0;
                align-self: flex-start;
                border-bottom-left-radius: 4px;
            }

            .chat-msg.user {
                background: linear-gradient(135deg, #f5a623, #e8572a);
                color: #000;
                align-self: flex-end;
                font-weight: 600;
                border-bottom-right-radius: 4px;
            }

            .chat-msg.typing {
                background: rgba(255,255,255,0.05);
                color: #a8d8ea;
                align-self: flex-start;
                font-style: italic;
                font-size: 0.8rem;
            }

        #chatbot-suggestions {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            padding: 8px 16px;
            border-top: 1px solid rgba(255,255,255,0.06);
        }

            #chatbot-suggestions button {
                background: rgba(255,255,255,0.06);
                border: 1px solid rgba(255,255,255,0.1);
                color: #a8d8ea;
                padding: 5px 10px;
                border-radius: 20px;
                font-size: 0.72rem;
                cursor: pointer;
                transition: background 0.2s;
            }

                #chatbot-suggestions button:hover {
                    background: rgba(245,166,35,0.15);
                    border-color: #f5a623;
                    color: #f5a623;
                }

        #chatbot-input-row {
            display: flex;
            gap: 8px;
            padding: 12px 16px;
            border-top: 1px solid rgba(255,255,255,0.08);
            background: #0d1117;
        }

        #chatbot-input {
            flex: 1;
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 12px;
            padding: 10px 14px;
            color: white;
            font-size: 0.84rem;
            outline: none;
            transition: border-color 0.2s;
        }

            #chatbot-input:focus {
                border-color: #f5a623;
            }

            #chatbot-input::placeholder {
                color: #4b5563;
            }

        #chatbot-input-row > button {
            background: linear-gradient(135deg, #f5a623, #e8572a);
            border: none;
            border-radius: 12px;
            width: 44px;
            color: #000;
            font-size: 18px;
            cursor: pointer;
            transition: transform 0.2s;
        }

            #chatbot-input-row > button:hover {
                transform: scale(1.08);
            }

        @@media (max-width: 480px) {
            #chatbot-window {
                width: 320px;
                right: -10px;
            }
        }
    </style>

    <script>
        function toggleChat() {
            const win = document.getElementById('chatbot-window');
            const isVisible = win.style.display !== 'none';
            win.style.display = isVisible ? 'none' : 'block';
            if (!isVisible) document.getElementById('chatbot-input').focus();
        }

        function handleKey(e) {
            if (e.key === 'Enter') sendMessage();
        }

        function askSuggestion(text) {
            document.getElementById('chatbot-input').value = text;
            sendMessage();
        }

        async function sendMessage() {
            const input   = document.getElementById('chatbot-input');
            const message = input.value.trim();
            if (!message) return;

            const messages = document.getElementById('chatbot-messages');

            // Message utilisateur
            messages.innerHTML += `<div class="chat-msg user">${escapeHtml(message)}</div>`;
            input.value = '';
            messages.scrollTop = messages.scrollHeight;

            // Typing indicator
            const typingId = 'typing-' + Date.now();
            messages.innerHTML += `
                <div class="chat-msg typing" id="${typingId}">
                    ⏳ En train de réfléchir...
                </div>`;
            messages.scrollTop = messages.scrollHeight;

            try {
                const res  = await fetch('/Chatbot/Send', {
                    method:  'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body:    JSON.stringify({
                        message: message,
                        context: document.title
                    })
                });

                const data = await res.json();

                document.getElementById(typingId)?.remove();
                messages.innerHTML += `<div class="chat-msg bot">${data.response}</div>`;
            } catch (err) {
                document.getElementById(typingId)?.remove();
                messages.innerHTML += `<div class="chat-msg bot">❌ Erreur de connexion.</div>`;
            }

            messages.scrollTop = messages.scrollHeight;
        }

        function escapeHtml(text) {
            return text
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;");
        }
    </script>
</head>

