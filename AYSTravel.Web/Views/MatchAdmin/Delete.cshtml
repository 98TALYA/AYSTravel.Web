@model AYSTravel.Data.Entities.Match

@{
    ViewData["Title"] = "Supprimer Match";
}

<div class="container-fluid py-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-danger mb-1">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                Suppression du Match
            </h3>
            <p class="text-muted mb-0">
                Cette action est irréversible. Vérifiez les informations avant confirmation.
            </p>
        </div>
    </div>

    <!-- CARD -->
    <div class="card shadow-sm border-0 rounded-4">

        <div class="card-body p-4">

            <!-- MATCH INFO BOX -->
            <div class="p-4 rounded-3 bg-light border mb-4">

                <h4 class="fw-bold mb-3">
                    @Model.Equipe1
                    <span class="text-muted">vs</span>
                    @Model.Equipe2
                </h4>

                <div class="row">

                    <div class="col-md-4 mb-2">
                        <strong>Stade :</strong><br />
                        <span class="text-muted">@Model.Stade</span>
                    </div>

                    <div class="col-md-4 mb-2">
                        <strong>Ville :</strong><br />
                        <span class="text-muted">@Model.Stade?.Nom</span>
                    </div>

                    <div class="col-md-4 mb-2">
                        <strong>Date :</strong><br />
                        <span class="text-muted">
                            @Model.Date.ToString("dd MMM yyyy")
                        </span>
                    </div>

                </div>
            </div>

            <!-- CONFIRMATION -->
            <div class="alert alert-danger d-flex align-items-center">
                <i class="bi bi-shield-exclamation me-2"></i>
                Êtes-vous sûr de vouloir supprimer ce match ?
            </div>

            <form asp-action="Delete" method="post">

                <input type="hidden" asp-for="Id" />

                <div class="mt-4 d-flex justify-content-end">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary px-4 me-3">
                        <i class="bi bi-arrow-left me-2"></i>
                        Annuler
                    </a>

                    <button type="submit"
                            class="btn btn-danger px-4">
                        <i class="bi bi-trash me-2"></i>
                        Confirmer Suppression
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>