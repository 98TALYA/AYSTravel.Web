@model AYSTravel.Data.Entities.Activite

@{
    ViewData["Title"] = "Supprimer Activité";
}

<div class="container-fluid py-5">

    <div class="card shadow-sm border-0 rounded-4 mx-auto" style="max-width:650px;">

        <div class="card-body p-4 text-center">

            <!-- HEADER -->
            <div class="mb-4">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-1"></i>

                <h3 class="fw-bold text-danger mt-3">
                    Supprimer cette activité ?
                </h3>

                <p class="text-muted">
                    Cette action est <strong>irréversible</strong>.
                </p>
            </div>

            <hr />

            <!-- INFOS ACTIVITÉ -->
            <div class="bg-light rounded-3 p-3 mb-4 text-start">

                <div class="mb-3">
                    <label class="form-label text-muted fw-semibold">
                        Nom
                    </label>
                    <div class="form-control bg-white">
                        @Model.Nom
                    </div>
                </div>

                <div>
                    <label class="form-label text-muted fw-semibold">
                        Description
                    </label>
                    <div class="form-control bg-white">
                        @Model.Description
                    </div>
                </div>

            </div>

            <!-- WARNING -->
            <div class="alert alert-danger">
                ⚠️ Cette suppression est définitive. Impossible de revenir en arrière.
            </div>

            <!-- FORM -->
            <form asp-action="Delete" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div class="d-flex justify-content-between mt-4">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary px-4">
                        <i class="bi bi-arrow-left me-2"></i>
                        Annuler
                    </a>

                    <button type="submit"
                            class="btn btn-danger px-4">
                        <i class="bi bi-trash-fill me-2"></i>
                        Supprimer définitivement
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>