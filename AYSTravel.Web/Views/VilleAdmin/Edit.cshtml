@model AYSTravel.Data.Entities.Ville

<div class="container-fluid py-5">
    <div class="card shadow-sm border-0 rounded-4 mx-auto" style="max-width:700px;">
        <div class="card-body p-4">

            <h3 class="fw-bold mb-4">Modifier la Ville</h3>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Nom" class="form-label fw-semibold"></label>
                    <input asp-for="Nom" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold"></label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"></textarea>
                </div>

                <div class="mb-4">
                    <label asp-for="ImageUrl" class="form-label fw-semibold">
                        Image URL
                    </label>
                    <input asp-for="ImageUrl"
                           class="form-control"
                           id="imageInput" />

                    <div class="mt-3 text-center">
                        <img id="previewImage"
                             src="~/image/@Model.ImageUrl"
                             class="img-fluid rounded shadow-sm"
                             style="max-height:200px;
                                    @(string.IsNullOrEmpty(Model.ImageUrl) ? "display:none;" : "")" />
                    </div>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index"
                       class="btn btn-outline-secondary px-4">
                        Annuler
                    </a>

                    <button type="submit"
                            class="btn btn-dark px-4">
                        Mettre à jour
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("imageInput")
            .addEventListener("input", function () {

            let img = document.getElementById("previewImage");
            img.src = this.value;

            if (this.value.trim() !== "") {
                img.style.display = "block";
            } else {
                img.style.display = "none";
            }
        });
    </script>
}