@using Microsoft.IdentityModel.Tokens
@model List<AYSTravel.Data.Entities.Ville>

@{
    ViewData["Title"] = "Gestion des Villes";
}

<div class="container-fluid py-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">Gestion des Villes</h3>
            <p class="text-muted mb-0">
                Administration des villes Coupe du Monde 2030
            </p>
        </div>

        <a asp-action="Create" class="btn btn-dark px-4">
            <i class="bi bi-plus-circle me-2"></i>
            Ajouter Ville
        </a>
    </div>

    <!-- STATS -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body">
                    <h6 class="text-muted mb-2">Total Villes</h6>
                    <h3 class="fw-bold mb-0">@Model.Count()</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- TABLE CARD -->
    <div class="card shadow-sm border-0 rounded-4">

        <div class="card-body p-3">

            <!-- SEARCH -->
            <div class="mb-3">
                <input type="text"
                       id="searchVille"
                       class="form-control"
                       placeholder="Rechercher une ville...">
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0"
                       id="villeTable">

                    <thead class="table-light">
                        <tr>
                            <th style="width:80px;">Image</th>
                            <th>Nom</th>
                            <th>Description</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var v in Model)
                            {
                                <tr>
                                    <!-- IMAGE -->
                                    <td>
                                        @if (!string.IsNullOrEmpty(v.ImageUrl))
                                        {
                                            <img src="/image/@v.ImageUrl"
                                                 class="rounded shadow-sm"
                                                 style="width:60px;height:60px;object-fit:cover;">
                                        }
                                        else
                                        {
                                            <div class="bg-light text-muted d-flex
                                                        align-items-center justify-content-center rounded"
                                                 style="width:60px;height:60px;font-size:12px;">
                                                No Img
                                            </div>
                                        }
                            </td>

                            <!-- NOM -->
                            <td class="fw-semibold">
                                @v.Nom
                            </td>

                            <!-- DESCRIPTION -->
                            <td class="text-muted">
                                @(string.IsNullOrEmpty(v.Description)
                                                                ? "Aucune description"
                                                                : v.Description.Length > 60
                                                                ? v.Description.Substring(0, 60) + "..."
                                                                : v.Description)
                            </td>

                                    <!-- ACTIONS -->
                                    <td class="text-end pe-4">
                                        <a asp-action="Edit"
                                           asp-route-id="@v.Id"
                                           class="btn btn-sm btn-outline-warning me-2">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@v.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                                                }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4"
                                    class="text-center py-4 text-muted">
                                    Aucune ville enregistrée.
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <script>
        document.getElementById("searchVille")
            .addEventListener("keyup", function () {

            let value = this.value.toLowerCase();
            let rows = document.querySelectorAll("#villeTable tbody tr");

            rows.forEach(row => {
                row.style.display =
                    row.innerText.toLowerCase().includes(value)
                    ? ""
                    : "none";
            });
        });
    </script>
}