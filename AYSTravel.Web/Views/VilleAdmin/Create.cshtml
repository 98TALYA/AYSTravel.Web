@model AYSTravel.Data.Entities.Ville

<div class="container-fluid py-5">
    <div class="card shadow-sm border-0 rounded-4 mx-auto" style="max-width:700px;">
        <div class="card-body p-4">

            <h3 class="fw-bold mb-4">Ajouter une Ville</h3>
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <!-- NOM -->
                <div class="mb-3">
                    <label asp-for="Nom" class="form-label fw-semibold"></label>
                    <input asp-for="Nom" class="form-control" />
                    <span asp-validation-for="Nom" class="text-danger"></span>
                </div>

                <!-- DESCRIPTION -->
                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold"></label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <!-- IMAGE UPLOAD -->
                <div class="mb-4">
                    <label class="form-label fw-semibold">
                        Image de la ville
                    </label>

                    <input type="file"
                           name="imageFile"
                           class="form-control"
                           id="imageInput"
                           accept="image/*" />

                    <div class="mt-3 text-center">
                        <img id="previewImage"
                             class="img-fluid rounded shadow-sm"
                             style="max-height:220px; display:none;" />
                    </div>
                </div>

                <!-- ACTIONS -->
                <div class="d-flex justify-content-between">
                    <a asp-action="Index"
                       class="btn btn-outline-secondary px-4">
                        Retour
                    </a>

                    <button type="submit"
                            class="btn btn-dark px-4">
                        Enregistrer
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("imageInput")
        .addEventListener("change", function () {

            let file = this.files[0];
            let img = document.getElementById("previewImage");

            if (file) {
                img.src = URL.createObjectURL(file);
                img.style.display = "block";
            } else {
                img.style.display = "none";
            }
        });
    </script>
}