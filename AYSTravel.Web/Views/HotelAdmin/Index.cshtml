@model IEnumerable<AYSTravel.Logic.Models.Hotel>

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h3 class="fw-bold">
            <i class="bi bi-building"></i> Gestion des Hôtels
        </h3>

        <a asp-action="Create" class="btn btn-dark">
            <i class="bi bi-plus-circle"></i> Ajouter Hôtel
        </a>

    </div>

    <!-- STATS -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <h6 class="text-muted mb-2">Total Hotels</h6>
                    <h3 class="fw-bold mb-0">@Model.Count()</h3>
                </div>
            </div>
        </div>
    </div>
    <!-- SEARCH -->
    <div class="mb-3">
        <input type="text"
               id="searchInput"
               class="form-control"
               placeholder="Rechercher un hotel...">
    </div>
    <div class="card shadow-sm border-0 rounded-4">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Image</th>
                            <th>Nom</th>
                            <th>Ville</th>
                            <th>Note</th>
                            <th>Population</th>
                            <th>Booking</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        <img src="@item.ImageUrl"
                                             style="width:80px;height:60px;object-fit:cover"
                                             class="rounded shadow-sm"
                                             onerror="this.src='/image/default.png'" />
                                    </td>

                                    <td class="fw-semibold">
                                        @item.Nom
                                    </td>

                                    <td>
                                        <i class="bi bi-geo-alt text-muted"></i>
                                        @item.Ville?.Nom
                                    </td>

                                    <td>
                                        <span class="badge bg-warning text-dark">
                                            ⭐ @item.Note
                                        </span>
                                    </td>

                                    <td>
                                        <span class="badge bg-info text-dark">
                                            👥 @item.Population
                                        </span>
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrEmpty(item.BookingUrl))
                                        {
                                            <a href="@item.BookingUrl"
                                               target="_blank"
                                               class="btn btn-sm btn-outline-success">
                                                <i class="bi bi-box-arrow-up-right"></i> Booking
                                            </a>
                                        }
                                    </td>

                                    <td class="text-end pe-4">
                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-warning me-2">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>

                                   

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    <i class="bi bi-info-circle"></i>
                                    Aucun hôtel trouvé
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
<!-- SEARCH SCRIPT -->
@section Scripts {
    <script>
        document.getElementById("searchInput").addEventListener("keyup", function () {

            let value = this.value.toLowerCase();
            let rows = document.querySelectorAll("#HotelTable tbody tr");

            rows.forEach(row => {
                row.style.display =
                    row.innerText.toLowerCase().includes(value)
                    ? ""
                    : "none";
            });
        });
    </script>
}