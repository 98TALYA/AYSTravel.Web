@using AYSTravel.Data.Entities
@model IEnumerable<AYSTravel.Web.ViewModels.MatchViewModel>

@{
    ViewData["Title"] = "Matchs";
}

<section class="match-hero d-flex align-items-center justify-content-center text-center">
    <div>
        <h1 class="display-3 fw-bold text-white ">World Cup 2030</h1>
        <p class="lead text-light">Matchs Officiels</p>
    </div>
</section>

<div class="container py-5">

    <!-- FILTRE PAR VILLE -->
    <div class="mb-4 text-center">
        <select id="villeFilter" class="form-select w-50 mx-auto">
            <option value="">Toutes les villes</option>
            @foreach (var ville in Model.Select(m => m.VilleNom).Distinct())
            {
                <option value="@ville">@ville</option>
            }
        </select>
    </div>

    <div class="row g-4" id="matchContainer">

        @foreach (var match in Model)
        {
            <div class="col-md-6 col-lg-4 match-item"
                 data-ville="@match.VilleNom">

                <div class="card match-card h-100 border-0 shadow-lg">

                    <!-- IMAGE STADE -->
                    <img src="@Url.Content("~/image/stades/" + match.StadeImageUrl)"
                         class="card-img-top"
                         style="height:200px;object-fit:cover;" />

                    <div class="card-body text-center p-4">

                        <!-- FLAGS AUTO (basé sur nom équipe) -->
                        <div class="d-flex justify-content-center align-items-center mb-3">

                            <img src="https://flagsapi.com/@match.Equipe1.Substring(0, 2).ToUpper()/flat/32.png"
                                 class="flag-img me-2" />

                            <strong class="text-warning">
                                @match.Equipe1
                            </strong>

                            <span class="mx-2 text-white">VS</span>

                            <strong class="text-warning">
                                @match.Equipe2
                            </strong>

                            <img src="https://flagsapi.com/@match.Equipe2.Substring(0, 2).ToUpper()/flat/32.png"
                                 class="flag-img ms-2" />

                        </div>

                        <!-- COUNTDOWN -->
                        <div class="countdown mb-3"
                             data-date="@match.Date.ToString("yyyy-MM-ddTHH:mm:ss")">
                        </div>

                        <p>🏟 @match.Stade</p>
                        <p>🏙 @match.VilleNom</p>
                        <p>📅 @match.Date.ToString("dd MMMM yyyy")</p>

                        <a asp-action="Details"
                           asp-route-id="@match.Id"
                           class="btn btn-outline-light rounded-pill w-100 mt-3">
                            Voir Détails
                        </a>

                    </div>
                </div>
            </div>
        }

    </div>
</div>
@section Script {
    <script>
        document.getElementById("villeFilter").addEventListener("change", function() {
            let filter = this.value.toLowerCase();
            let matchItems = document.querySelectorAll("#matchContainer .match-item");

            matchItems.forEach(function(item) {
                let ville = item.getAttribute("data-ville").toLowerCase();

                if (filter === "" || ville === filter) {
                    item.style.display = "block";
                } else {
                    item.style.display = "none";
                }
            });
        });
    </script>
}
