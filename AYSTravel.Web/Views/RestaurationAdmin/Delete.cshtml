@model AYSTravel.Data.Entities.Restauration

@{
    ViewData["Title"] = "Supprimer Restaurant";
}

<div class="container-fluid py-5">

    <div class="card shadow-lg border-0 rounded-4 mx-auto" style="max-width:600px;">

        <div class="card-body p-5 text-center">

            <!-- ICON -->
            <div class="mb-3">
                <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size:3rem;"></i>
            </div>

            <!-- TITLE -->
            <h3 class="fw-bold text-danger mb-2">
                Confirmation de suppression
            </h3>

            <p class="text-muted mb-4">
                Cette action est <strong>irréversible</strong>. Voulez-vous vraiment supprimer ce restaurant ?
            </p>

            <!-- INFO BOX -->
            <div class="bg-light rounded-3 p-3 mb-4 text-start">

                <div class="mb-2">
                    <span class="text-muted">Nom :</span>
                    <strong class="ms-2">@Model.Nom</strong>
                </div>
            </div>
                

            

            <!-- FORM -->
            <form asp-action="Delete" method="post">

                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="d-flex justify-content-center gap-2">

                    <button type="submit" class="btn btn-danger px-4">
                        <i class="bi bi-trash me-1"></i>
                        Supprimer
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        Annuler
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>