@model AYSTravel.Data.Entities.Restauration

@{
    ViewData["Title"] = "Modifier Restaurant";
}

<div class="container-fluid py-4">

    <h3 class="fw-bold mb-4">Modifier Restaurant</h3>

    <div class="card shadow-sm border-0 rounded-4">

        <div class="card-body p-4">

            <form asp-action="Edit" method="post">

                <input type="hidden" asp-for="Id" />

                <div class="row g-4">

                    <div class="col-md-6">

                        <label asp-for="Nom" class="form-label fw-semibold"></label>

                        <input asp-for="Nom" class="form-control" />

                    </div>

                    <div class="col-md-3">

                        <label asp-for="Type" class="form-label fw-semibold"></label>

                        <select asp-for="Type" class="form-select">
                            <option>Restaurant</option>
                            <option>Café</option>
                        </select>

                    </div>

                    <div class="col-md-3">

                        <label asp-for="Budget" class="form-label fw-semibold"></label>

                        <select asp-for="Budget" class="form-select">
                            <option>Economique</option>
                            <option>Moyen</option>
                            <option>Elevé</option>
                        </select>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="Adresse" class="form-label fw-semibold"></label>

                        <input asp-for="Adresse" class="form-control" />

                    </div>

                    <div class="col-md-6">

                        <label asp-for="ImageUrl" class="form-label fw-semibold"></label>

                        <input asp-for="ImageUrl" class="form-control" />

                    </div>

                    <div class="col-md-4">

                        <label asp-for="VilleId" class="form-label fw-semibold"></label>

                        <select asp-for="VilleId"
                                asp-items="ViewBag.Villes"
                                class="form-select">
                        </select>

                    </div>

                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end">

                    <a asp-action="Index" class="btn btn-light me-2">
                        Annuler
                    </a>

                    <button class="btn btn-dark px-4">
                        Enregistrer
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>