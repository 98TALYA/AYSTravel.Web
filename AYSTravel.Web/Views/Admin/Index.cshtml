@model AYSTravel.Web.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Dashboard Admin";

    var stats = new[]
    {
        new { Title = "Utilisateurs", Value = Model.TotalUsers, Icon = "bi-people-fill" },
        new { Title = "Matchs", Value = Model.TotalMatchs, Icon = "bi-trophy-fill" },
        new { Title = "Activités", Value = Model.TotalActivites, Icon = "bi-geo-alt-fill" },
        new { Title = "Monuments", Value = Model.TotalMonuments, Icon = "bi-building" },
        new { Title = "Villes", Value = Model.TotalVilles, Icon = "bi-geo-alt" },
        new { Title = "Transports", Value = Model.TotalTransports, Icon = "bi-train-front-fill" },
        new { Title = "Restaurations", Value = Model.TotalRestaurations, Icon = "bi-cup-hot-fill" }
    };

    var menus = new[]
    {
        new { Name="Utilisateurs", Controller="Admin", Action="Users", Icon="bi-people" },
        new { Name="Villes", Controller="VilleAdmin", Action="Index", Icon="bi-geo-alt" },
        new { Name="Matchs", Controller="MatchAdmin", Action="Index", Icon="bi-trophy" },
        new { Name="Monuments", Controller="MonumentAdmin", Action="Index", Icon="bi-building" },
        new { Name="Activités", Controller="ActiviteAdmin", Action="Index", Icon="bi-map" },
        new { Name="Restaurants", Controller="RestaurationAdmin", Action="Index", Icon="bi-cup-hot" },
        new { Name="Hôtels", Controller="HotelAdmin", Action="Index", Icon="bi-building-check" }
    };
}

<div class="container-fluid py-5">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-5 p-3 bg-light rounded-4 shadow-sm">
        <div>
            <h2 class="fw-bold mb-1">Dashboard Administrateur</h2>
            <p class="text-muted mb-0">Gestion complète de la plateforme AYSTravel</p>
        </div>

        <a asp-controller="Home" asp-action="Index"
           class="btn btn-dark px-4 rounded-3 shadow-sm">
            Retour au site
        </a>
    </div>

    <!-- STATS -->
    <div class="row g-4 mb-5">

        @foreach (var stat in stats)
        {
            <div class="col-xl-3 col-md-6">
                <div class="stat-card">

                    <div>
                        <p class="stat-title">@stat.Title</p>
                        <h3 class="stat-value">@stat.Value</h3>
                    </div>

                    <div class="stat-icon">
                        <i class="bi @stat.Icon"></i>
                    </div>

                </div>
            </div>
        }

    </div>

    <!-- GESTION -->
    <div class="mb-4">
        <h4 class="fw-bold mb-3">Gestion des contenus</h4>

        <div class="row g-4">

            @foreach (var m in menus)
            {
                <div class="col-lg-3 col-md-4 col-sm-6">

                    <a asp-controller="@m.Controller"
                       asp-action="@m.Action"
                       class="manage-card">

                        <i class="bi @m.Icon"></i>
                        <span>@m.Name</span>

                    </a>

                </div>
            }

        </div>
    </div>

</div>

<!-- STYLE -->
<style>

    .stat-card {
        background: #fff;
        border-radius: 16px;
        padding: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 8px 20px rgba(0,0,0,0.06);
        transition: 0.25s ease;
        border: 1px solid #f1f1f1;
    }

        .stat-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.12);
        }

    .stat-title {
        font-size: 14px;
        color: #6c757d;
        margin-bottom: 4px;
    }

    .stat-value {
        font-size: 26px;
        font-weight: 700;
        margin: 0;
    }

    .stat-icon {
        width: 55px;
        height: 55px;
        border-radius: 14px;
        background: linear-gradient(135deg, #1f1f1f, #3a3a3a);
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .stat-icon i {
            font-size: 24px;
            color: white;
        }

    /* MENU CARDS */
    .manage-card {
        background: #fff;
        border-radius: 16px;
        padding: 25px;
        text-align: center;
        display: block;
        text-decoration: none;
        color: #1f1f1f;
        box-shadow: 0 6px 18px rgba(0,0,0,0.05);
        transition: 0.25s ease;
        border: 1px solid #f1f1f1;
    }

        .manage-card i {
            font-size: 28px;
            display: block;
            margin-bottom: 10px;
        }

        .manage-card span {
            font-weight: 600;
        }

        .manage-card:hover {
            transform: translateY(-6px);
            background: #1f1f1f;
            color: white;
        }

</style>