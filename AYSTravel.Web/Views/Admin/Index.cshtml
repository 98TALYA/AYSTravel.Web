@model AYSTravel.Web.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Dashboard Admin";
}

<div class="container-fluid py-4">
    <h1 class="mb-4 text-dark-emphasis fw-bold">👑 Dashboard Administrateur</h1>

    <div class="row g-4">
        <!-- Utilisateurs -->
        <div class="col-md-4 col-sm-6">
            <div class="card shadow-sm text-white" style="background: linear-gradient(135deg,#0f2027,#203a43); border-radius: 20px;">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="fw-semibold">Utilisateurs</h6>
                        <h3 class="fw-bold">@Model.TotalUsers</h3>
                    </div>
                    <i class="bi bi-people-fill fs-2"></i>
                </div>
            </div>
        </div>

        <!-- Matches -->
        <div class="col-md-4 col-sm-6">
            <div class="card shadow-sm text-white" style="background: linear-gradient(135deg,#0f2027,#203a43); border-radius: 20px;">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="fw-semibold">Matches</h6>
                        <h3 class="fw-bold">@Model.TotalMatchs</h3>
                    </div>
                    <i class="bi bi-trophy-fill fs-2"></i>
                </div>
            </div>
        </div>

        <!-- Activités -->
        <div class="col-md-4 col-sm-6">
            <div class="card shadow-sm text-white" style="background: linear-gradient(135deg,#0f2027,#203a43); border-radius: 20px;">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="fw-semibold">Activités</h6>
                        <h3 class="fw-bold">@Model.TotalActivites</h3>
                    </div>
                    <i class="bi bi-geo-alt-fill fs-2"></i>
                </div>
            </div>
        </div>

        <!-- Monuments -->
        <div class="col-md-4 col-sm-6">
            <div class="card shadow-sm text-white" style="background: linear-gradient(135deg,#0f2027,#203a43); border-radius: 20px;">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="fw-semibold">Monuments</h6>
                        <h3 class="fw-bold">@Model.TotalMonuments</h3>
                    </div>
                    <i class="bi bi-building fs-2"></i>
                </div>
            </div>
        </div>

        <!-- Villes -->
        <div class="col-md-4 col-sm-6">
            <div class="card shadow-sm text-white" style="background: linear-gradient(135deg,#0f2027,#203a43); border-radius: 20px;">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="fw-semibold">Villes</h6>
                        <h3 class="fw-bold">@Model.TotalVilles</h3>
                    </div>
                    <i class="bi bi-geo-alt fs-2"></i>
                </div>
            </div>
        </div>

        <!-- Transports -->
        <div class="col-md-4 col-sm-6">
            <div class="card shadow-sm text-white" style="background: linear-gradient(135deg,#0f2027,#203a43); border-radius: 20px;">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="fw-semibold">Transports</h6>
                        <h3 class="fw-bold">@Model.TotalTransports</h3>
                    </div>
                    <i class="bi bi-train-front-fill fs-2"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Liens rapides -->
    <div class="d-flex gap-3 mt-4">
        <a asp-controller="Admin" asp-action="Users" class="btn btn-gold fw-bold">
            Gestion des utilisateurs
        </a>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark fw-bold">
            Retour au site
        </a>
    </div>
</div>