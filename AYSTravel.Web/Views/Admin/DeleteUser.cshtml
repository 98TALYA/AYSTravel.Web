@model Microsoft.AspNetCore.Identity.IdentityUser

@{
    ViewData["Title"] = "Supprimer utilisateur";
}

<div class="container py-5">

    <div class="card shadow border-0 rounded-4 mx-auto" style="max-width:600px;">
        <div class="card-body p-4 text-center">

            <i class="bi bi-exclamation-triangle-fill text-danger mb-3" style="font-size:3rem;"></i>

            <h4 class="text-danger fw-bold">Supprimer utilisateur</h4>

            <p class="text-muted">
                Cette action est définitive.
            </p>

            <hr />

            <p><strong>@Model.UserName</strong></p>
            <p>@Model.Email</p>

            <form asp-action="DeleteUsers" method="post">

                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="mt-4 d-flex justify-content-between">

                    <a asp-action="Users" class="btn btn-outline-secondary">
                        Annuler
                    </a>

                    <button type="submit" class="btn btn-danger">
                        Supprimer
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>