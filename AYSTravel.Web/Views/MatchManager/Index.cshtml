@model IEnumerable<AYSTravel.Data.Entities.Match>

@{
    ViewData["Title"] = "Gestion des Matchs";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-warning">⚽ Gestion des Matchs</h2>

        <a asp-action="Create" class="btn btn-success">
            ➕ Ajouter un Match
        </a>
    </div>

    <div class="card shadow-lg p-4">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Équipe 1</th>
                    <th>Équipe 2</th>
                    <th>Stade</th>
                    <th>Date</th>
                    
                    <th class="text-center">Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var match in Model)
                {
                    <tr>
                        <td>@match.Equipe1</td>
                        <td>@match.Equipe2</td>
                        <td>@match.Stade</td>
                        <td>@match.Date.ToString("dd/MM/yyyy")</td>
                        
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@match.Id"
                               class="btn btn-sm btn-primary me-2">
                                ✏️
                            </a>

                            <a asp-action="Delete" asp-route-id="@match.Id"
                               class="btn btn-sm btn-danger">
                                🗑
                            </a>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>

</div>