@model AYSTravel.Data.Entities.Monument

<div class="container-fluid py-5">
    <div class="card shadow-sm border-0 rounded-4 mx-auto" style="max-width:700px;">
        <div class="card-body p-4">

            <h3 class="fw-bold mb-4">Ajouter un Monument</h3>
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
                
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="Nom" class="form-label fw-semibold"></label>
                    <input asp-for="Nom" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold"></label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="Adress" class="form-label fw-semibold"></label>
                    <input asp-for="Adress" class="form-control" />
                </div>

                    <div class="mb-3">
                        <label asp-for="VilleId" class="form-label fw-semibold"></label>

                        <select asp-for="VilleId"
                                asp-items="ViewBag.Villes"
                                class="form-select">
                            <option value="">-- Choisir une ville --</option>
                        </select>

                        <span asp-validation-for="VilleId" class="text-danger small"></span>
                    </div>

                <div class="mb-4">
                    <label asp-for="ImageUrl" class="form-label fw-semibold">
                        Image URL
                    </label>

                    <input asp-for="ImageUrl"
                           class="form-control"
                           id="imageInput" />

                    <div class="mt-3 text-center">
                        <img id="previewImage"
                             src=""
                             class="img-fluid rounded shadow-sm"
                             style="max-height:200px; display:none;" />
                    </div>
                </div>

                <div class="d-flex justify-content-between">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary px-4">
                        Retour
                    </a>

                    <button type="submit"
                            class="btn btn-dark px-4">
                        Enregistrer
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script>

        document.getElementById("imageInput")
        .addEventListener("input", function () {

            let img = document.getElementById("previewImage");
            img.src = this.value;

            if (this.value.trim() !== "") {
                img.style.display = "block";
            } else {
                img.style.display = "none";
            }

        });

    </script>
}