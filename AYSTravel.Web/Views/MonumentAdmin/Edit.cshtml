@model AYSTravel.Data.Entities.Monument

<div class="container-fluid py-5">
    <div class="card shadow-sm border-0 rounded-4 mx-auto" style="max-width:700px;">
        <div class="card-body p-4">

            <h3 class="fw-bold mb-4">Modifier Monument</h3>

            <form asp-action="Edit" method="post">

                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Nom" class="form-label fw-semibold"></label>
                    <input asp-for="Nom" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold"></label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="Adress" class="form-label fw-semibold"></label>
                    <input asp-for="Adress" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="VilleId" class="form-label fw-semibold"></label>
                    <input asp-for="VilleId" class="form-control" />
                </div>

                <div class="mb-4">

                    <label asp-for="ImageUrl" class="form-label fw-semibold">
                        Image URL
                    </label>

                    <input asp-for="ImageUrl"
                           class="form-control"
                           id="imageInput" />

                    <div class="mt-3 text-center">

                        <img id="previewImage"
                             src="@Model.ImageUrl"
                             class="img-fluid rounded shadow-sm"
                             style="max-height:200px;" />

                    </div>

                </div>

                <div class="d-flex justify-content-between">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary px-4">
                        Retour
                    </a>

                    <button type="submit"
                            class="btn btn-dark px-4">
                        Modifier
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script>

        document.getElementById("imageInput")
        .addEventListener("input", function () {

            let img = document.getElementById("previewImage");
            img.src = this.value;

        });

    </script>
}