@{
    ViewData["Title"] = "Accueil";
}

@section Styles {
    <style>

        /* ================= HERO ================= */
        .hero {
            height: 90vh;
            background: linear-gradient(rgba(0,0,0,.6), rgba(0,0,0,.85)), url("/image/2030.png");
            background-size: cover;
            background-position: center;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            border-radius: 0 0 60px 60px;
            color: white;
        }

            .hero h1 {
                font-size: 4rem;
                font-weight: 900;
            }

            .hero span {
                color: #facc15;
            }

            .hero p {
                max-width: 650px;
                margin: 20px auto;
                opacity: .9;
            }

        /* ================= TITLES ================= */
        .section-title {
            font-weight: 800;
            text-align: center;
            margin-bottom: 40px;
        }

            .section-title::after {
                content: "";
                width: 70px;
                height: 4px;
                background: #dc2626;
                display: block;
                margin: 10px auto 0;
                border-radius: 2px;
            }

        /* ================= CARDS ================= */
        .modern-card {
            border-radius: 20px;
            overflow: hidden;
            background: white;
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
            transition: 0.3s ease;
        }

            .modern-card:hover {
                transform: translateY(-8px);
                box-shadow: 0 20px 40px rgba(0,0,0,0.15);
            }

        .img-wrapper {
            height: 220px;
            overflow: hidden;
        }

            .img-wrapper img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: 0.4s;
            }

        .modern-card:hover img {
            transform: scale(1.05);
        }

        .modern-card h5 {
            font-weight: 700;
        }

        .modern-card p {
            color: #6c757d;
            font-size: 14px;
        }

        /* ================= BADGE ================= */
        .badge-action {
            background: #111;
            color: white;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 12px;
        }

        /* ================= BUTTON ================= */
        .btn-modern {
            border-radius: 30px;
            padding: 10px 25px;
        }

    </style>
}

<!-- ================= HERO ================= -->
<section class="hero">
    <div class="container">

        <h1>AYS <span>GUIDE</span></h1>

        <p>
            Découvrez le Maroc pendant la Coupe du Monde :
            villes, stades, gastronomie et patrimoine.
        </p>

        <a asp-controller="Ville"
           class="btn btn-warning btn-lg btn-modern fw-bold">
            Explorer maintenant
        </a>

    </div>
</section>

<!-- ================= VILLES ================= -->
<section class="container py-5">

    <h2 class="section-title">Villes hôtes</h2>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="modern-card">
                <div class="img-wrapper">
                    <img src="/image/5.png" />
                </div>
                <div class="p-3">
                    <h5>Marrakech</h5>
                    <p>Culture et ambiance festive</p>
                    <span class="badge-action">Découvrir</span>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="modern-card">
                <div class="img-wrapper">
                    <img src="/image/Mosquée Hassan II.webp" />
                </div>
                <div class="p-3">
                    <h5>Casablanca</h5>
                    <p>Capitale économique</p>
                    <span class="badge-action">Découvrir</span>
                </div>
            </div>
        </div>

        <div class="col-md-4">
