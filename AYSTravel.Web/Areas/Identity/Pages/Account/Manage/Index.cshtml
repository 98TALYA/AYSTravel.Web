@page
@model IndexModel
@{
    ViewData["Title"] = "Profil";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<div class="profile-wrapper">

    <div class="profile-card">

        <!-- HEADER -->
        <div class="profile-header text-center">

            <div class="profile-avatar">
                <i class="bi bi-person-fill"></i>
            </div>

            <h2 class="fw-bold">Mon Profil</h2>
            <p class="text-muted">Gérez vos informations personnelles</p>

        </div>

        <!-- STATUS MESSAGE -->
        <partial name="_StatusMessage" for="StatusMessage" />

        <!-- FORM -->
        <form id="profile-form" method="post">

            <div asp-validation-summary="All" class="text-danger small mb-3"></div>

            <!-- USERNAME -->
            <div class="form-group">
                <label>Nom d'utilisateur</label>
                <div class="input-icon">
                    <i class="bi bi-person"></i>
                    <input asp-for="Username"
                           class="form-control" />
                           
                </div>
             
            </div>

            <!-- PHONE -->
            <div class="form-group">
                <label>Numéro de téléphone</label>
                <div class="input-icon">
                    <i class="bi bi-telephone"></i>
                    <input asp-for="Input.PhoneNumber"
                           class="form-control"
                           placeholder="Ex: 06xxxxxxxx" />
                </div>
                <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
            </div>

            <!-- BUTTON -->
            <button type="submit" class="btn-save w-100">
                <i class="bi bi-check-circle me-2"></i>
                Enregistrer
            </button>

            <!-- PASSWORD -->
            <div class="text-center mt-4">
                <a asp-page="./ChangePassword" class="change-link">
                    🔒 Modifier le mot de passe
                </a>
            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}