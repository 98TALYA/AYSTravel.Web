@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Changer le mot de passe";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="auth-wrapper">

    <div class="auth-card">

        <!-- HEADER -->
        <div class="text-center mb-4">

            <div class="auth-icon">
                🔒
            </div>

            <h2>Changer le mot de passe</h2>
            <p>Sécurisez votre compte avec un nouveau mot de passe</p>

        </div>

        <partial name="_StatusMessage" for="StatusMessage" />

        <!-- FORM -->
        <form id="change-password-form" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <!-- OLD PASSWORD -->
            <div class="form-group">
                <label>Mot de passe actuel</label>
                <div class="input-icon">
                    <i class="bi bi-lock"></i>
                    <input asp-for="Input.OldPassword"
                           type="password"
                           class="form-control"
                           placeholder="••••••••" />
                </div>
                <span asp-validation-for="Input.OldPassword" class="text-danger small"></span>
            </div>

            <!-- NEW PASSWORD -->
            <div class="form-group">
                <label>Nouveau mot de passe</label>
                <div class="input-icon">
                    <i class="bi bi-shield-lock"></i>
                    <input asp-for="Input.NewPassword"
                           type="password"
                           class="form-control"
                           placeholder="••••••••" />
                </div>
                <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
            </div>

            <!-- CONFIRM -->
            <div class="form-group">
                <label>Confirmer mot de passe</label>
                <div class="input-icon">
                    <i class="bi bi-check2-circle"></i>
                    <input asp-for="Input.ConfirmPassword"
                           type="password"
                           class="form-control"
                           placeholder="••••••••" />
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>

            <!-- BUTTON -->
            <button type="submit" class="btn-gold w-100">
                Mettre à jour
            </button>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}