@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Confirmation";
}

<div class="auth-wrapper">

    <div class="auth-card text-center">

        <!-- ICON MAIL -->
        <div class="mail-icon mb-3">
            ✉
        </div>

        <!-- TITLE -->
        <h2 class="fw-bold mb-2">Vérifiez votre email</h2>

        <!-- MESSAGE -->
        <p class="text-muted mb-4">
            Un lien de réinitialisation a été envoyé à votre adresse email.<br />
            Consultez votre boîte de réception pour continuer.
        </p>

        <!-- BUTTON -->
        <a asp-area="Identity"
           asp-page="/Account/Login"
           class="btn-gold w-100">
            Retour à la connexion
        </a>

    </div>

</div>