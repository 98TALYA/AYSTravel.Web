@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Mot de passe oublié";
}

<div class="auth-wrapper d-flex align-items-center justify-content-center">

    <div class="auth-carde">

        <div class="text-center mb-4">
            <img src="~/image/logo.png" class="auth-logo mb-3" />
            <h2 class="fw-bold text-white">Mot de passe oublié</h2>
            <p class="text-muted">
                Entrez votre email pour recevoir un lien de réinitialisation
            </p>
        </div>

        <form method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="form-floating mb-4">
                <input asp-for="Input.Email"
                       class="form-control auth-input"
                       autocomplete="username"
                       placeholder="name@example.com" />
                <label asp-for="Input.Email">Email</label>
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <button type="submit"
                    class="btn btn-gold w-100 py-2 mb-3">
                Envoyer le lien
            </button>

            <div class="text-center small">
                <a asp-page="./Login" class="auth-link">
                    Retour à la connexion
                </a>
            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}