@page
@model LoginModel
@{
    ViewData["Title"] = "Connexion";
}

@section Styles {
    <style>
        body {
            background: linear-gradient(135deg,#0f172a,#1e293b);
            min-height: 100vh;
        }

        .auth-wrapper {
            min-height: 90vh;
        }

        .auth-card {
            width: 100%;
            max-width: 420px;
            padding: 40px;
            border-radius: 20px;
            backdrop-filter: blur(15px);
            background: rgba(255,255,255,0.08);
            box-shadow: 0 30px 70px rgba(0,0,0,.4);
            animation: fade .6s ease;
        }

       

      

        .auth-logo {
            width: 80px;
            filter: drop-shadow(0 0 8px gold);
        }

        .auth-input {
            border-radius: 12px;
            border: 1px solid rgba(255,255,255,.2);
            background: rgba(255,255,255,.05);
            color: white;
        }

            .auth-input:focus {
                border-color: #facc15;
                box-shadow: 0 0 0 .2rem rgba(250,204,21,.25);
                background: rgba(255,255,255,.1);
                color: white;
            }

        label {
            color: #d1d5db;
        }

        .btn-gold {
            background: #facc15;
            border: none;
            font-weight: 700;
            border-radius: 12px;
            transition: .3s;
        }

            .btn-gold:hover {
                background: #eab308;
                transform: translateY(-2px);
                box-shadow: 0 10px 25px rgba(250,204,21,.4);
            }

        .auth-link {
            color: #facc15;
            text-decoration: none;
        }

            .auth-link:hover {
                text-decoration: underline;
                color: #fde047;
            }

        .toggle-pass {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: #facc15;
            font-size: 14px;
        }

        .password-box {
            position: relative;
        }
    </style>
}

<div class="auth-wrapper d-flex align-items-center justify-content-center">

    <div class="auth-card">

        <div class="text-center mb-4">
            <img src="~/image/logo.png" class="auth-logo mb-3" />
            <h2 class="fw-bold text-white">Connexion</h2>
            <p class="text-light small">Accédez à votre espace AYS GUIDE 2030</p>
        </div>

        <form method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Email"
                       class="form-control auth-input"
                       placeholder="email" />
                <label asp-for="Input.Email">Email</label>
            </div>

            <div class="form-floating mb-3 password-box">

                <input asp-for="Input.Password"
                       id="passwordField"
                       type="password"
                       class="form-control auth-input"
                       placeholder="password" />

                <label asp-for="Input.Password">Mot de passe</label>

                <span class="toggle-pass"
                      onclick="togglePassword()">👁</span>

            </div>

            <div class="form-check mb-3">
                <input class="form-check-input" asp-for="Input.RememberMe" />
                <label class="form-check-label text-light"
                       asp-for="Input.RememberMe">
                    Se souvenir de moi
                </label>
            </div>

            <button type="submit" class="btn btn-gold w-100 py-2 mb-3">
                Se connecter
            </button>

            <div class="text-center small">
                <a asp-page="./ForgotPassword" class="auth-link">
                    Mot de passe oublié ?
                </a>
                <br />
                <a asp-page="./Register"
                   asp-route-returnUrl="@Model.ReturnUrl"
                   class="auth-link">
                    Créer un compte
                </a>
            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function togglePassword(){
            const input = document.getElementById("passwordField");
            input.type = input.type === "password" ? "text" : "password";
        }
    </script>
}