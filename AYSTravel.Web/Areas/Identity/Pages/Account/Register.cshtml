@page
@model RegisterModel
@{
    ViewData["Title"] = "Inscription";
}

<div class="auth-wrapper d-flex align-items-center justify-content-center">

    <div class="auth-card">

        <div class="text-center mb-4">
            <img src="~/image/logo.png" class="auth-logo mb-3" />
            <h2 class="fw-bold text-white">Créer un compte</h2>
            <p class="text-muted">Rejoignez la plateforme AYS GUIDE 2030</p>
        </div>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <!-- Email -->
            <div class="form-floating mb-3">
                <input asp-for="Input.Email"
                       class="form-control auth-input"
                       autocomplete="username"
                       placeholder="name@example.com" />
                <label asp-for="Input.Email">Email</label>
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <!-- Password -->
            <div class="form-floating mb-3">
                <input asp-for="Input.Password"
                       type="password"
                       class="form-control auth-input"
                       autocomplete="new-password"
                       placeholder="password" />
                <label asp-for="Input.Password">Mot de passe</label>
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <!-- Confirm Password -->
            <div class="form-floating mb-3">
                <input asp-for="Input.ConfirmPassword"
                       type="password"
                       class="form-control auth-input"
                       autocomplete="new-password"
                       placeholder="confirm password" />
                <label asp-for="Input.ConfirmPassword">Confirmer mot de passe</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>

            <!-- Submit -->
            <button type="submit"
                    class="btn btn-gold w-100 py-2 mb-3">
                S'inscrire
            </button>

            <!-- Links -->
            <div class="text-center small">
                <a asp-page="./Login"
                   asp-route-returnUrl="@Model.ReturnUrl"
                   class="auth-link">
                    Déjà un compte ? Se connecter
                </a>
            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}